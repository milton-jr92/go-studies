*.o
*.a
*.cgo1.go
*.cgo2.c

# Go build cache
/cache/

# GoLand project files
*.iml

# Test binary
*.test

# Coverage files
coverage*

# Module cache (if not in GOPATH)
/pkg/mod/

# Go environment files
.env
.env.*

# Local binaries
/bin/

# Go workspace settings (safe to ignore for study/experiments)
go.work
*.sum
*.mod
